{
    "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "color": {
            "palette": [
                {
                    "slug": "primary",
                    "color": "#0B0B0B",
                    "name": "Primary Black"
                },
                {
                    "slug": "secondary",
                    "color": "#D4AF37",
                    "name": "Secondary Gold"
                },
                {
                    "slug": "base",
                    "color": "#F8F8F8",
                    "name": "Accent White"
                },
                {
                    "slug": "contrast",
                    "color": "#1A1A1A",
                    "name": "Contrast Dark"
                },
                {
                    "slug": "muted",
                    "color": "#6B6B6B",
                    "name": "Muted Text"
                },
                {
                    "slug": "white",
                    "color": "#FFFFFF",
                    "name": "Pure White"
                },
                {
                    "slug": "gold-light",
                    "color": "#F5E6A3",
                    "name": "Gold Light"
                },
                {
                    "slug": "gold-dark",
                    "color": "#B8960C",
                    "name": "Gold Dark"
                },
                {
                    "slug": "dark-surface",
                    "color": "#111111",
                    "name": "Dark Surface"
                },
                {
                    "slug": "card-bg",
                    "color": "#FFFFFF",
                    "name": "Card Background"
                }
            ],
            "gradients": [
                {
                    "slug": "gold-gradient",
                    "gradient": "linear-gradient(135deg, #D4AF37 0%, #B8960C 100%)",
                    "name": "Gold Gradient"
                },
                {
                    "slug": "dark-gradient",
                    "gradient": "linear-gradient(135deg, #0B0B0B 0%, #1A1A1A 100%)",
                    "name": "Dark Gradient"
                },
                {
                    "slug": "hero-overlay",
                    "gradient": "linear-gradient(135deg, rgba(11,11,11,0.92) 0%, rgba(11,11,11,0.6) 100%)",
                    "name": "Hero Overlay"
                }
            ],
            "duotone": [
                {
                    "slug": "black-gold",
                    "colors": ["#0B0B0B", "#D4AF37"],
                    "name": "Black to Gold"
                }
            ],
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "link": true,
            "background": true,
            "text": true
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "'Poppins', sans-serif",
                    "slug": "poppins",
                    "name": "Poppins",
                    "fontFace": [
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": ["https://fonts.gstatic.com/s/poppins/v20/pxiEyp8kv8JHgFVrJJfecg.woff2"]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "500",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": ["https://fonts.gstatic.com/s/poppins/v20/pxiByp8kv8JHgFVrLGT9Z1xlFQ.woff2"]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "600",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": ["https://fonts.gstatic.com/s/poppins/v20/pxiByp8kv8JHgFVrLEj6Z1xlFQ.woff2"]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "700",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": ["https://fonts.gstatic.com/s/poppins/v20/pxiByp8kv8JHgFVrLCz7Z1xlFQ.woff2"]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "800",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": ["https://fonts.gstatic.com/s/poppins/v20/pxiByp8kv8JHgFVrLDD4Z1xlFQ.woff2"]
                        }
                    ]
                },
                {
                    "fontFamily": "Georgia, 'Times New Roman', serif",
                    "slug": "serif",
                    "name": "Serif (Accent)"
                }
            ],
            "fontSizes": [
                {
                    "slug": "xs",
                    "size": "0.75rem",
                    "name": "Extra Small"
                },
                {
                    "slug": "small",
                    "size": "0.875rem",
                    "name": "Small"
                },
                {
                    "slug": "medium",
                    "size": "1rem",
                    "name": "Medium"
                },
                {
                    "slug": "large",
                    "size": "1.125rem",
                    "name": "Large"
                },
                {
                    "slug": "xl",
                    "size": "1.5rem",
                    "name": "Extra Large"
                },
                {
                    "slug": "xxl",
                    "size": "2rem",
                    "name": "2X Large"
                },
                {
                    "slug": "xxxl",
                    "size": "clamp(2rem, 5vw, 3.5rem)",
                    "name": "3X Large"
                },
                {
                    "slug": "hero",
                    "size": "clamp(2.2rem, 6vw, 4.5rem)",
                    "name": "Hero Size"
                }
            ],
            "lineHeight": true,
            "letterSpacing": true,
            "textTransform": true,
            "textDecoration": true,
            "fontStyle": true,
            "fluid": true,
            "defaultFontSizes": false
        },
        "spacing": {
            "spacingSizes": [
                { "slug": "10", "size": "0.5rem", "name": "XS" },
                { "slug": "20", "size": "1rem", "name": "Small" },
                { "slug": "30", "size": "1.5rem", "name": "Medium Small" },
                { "slug": "40", "size": "2rem", "name": "Medium" },
                { "slug": "50", "size": "3rem", "name": "Large" },
                { "slug": "60", "size": "4rem", "name": "XL" },
                { "slug": "70", "size": "clamp(3rem, 8vw, 6rem)", "name": "XXL" },
                { "slug": "80", "size": "clamp(4rem, 10vw, 8rem)", "name": "Section" }
            ],
            "padding": true,
            "margin": true,
            "blockGap": true,
            "units": ["px", "%", "em", "rem", "vw", "vh"],
            "defaultSpacingSizes": false
        },
        "layout": {
            "contentSize": "1200px",
            "wideSize": "1440px"
        },
        "blocks": {
            "core/button": {
                "color": {
                    "palette": [
                        {
                            "slug": "primary",
                            "color": "#0B0B0B",
                            "name": "Primary"
                        },
                        {
                            "slug": "secondary",
                            "color": "#D4AF37",
                            "name": "Gold"
                        }
                    ]
                }
            },
            "core/navigation": {
                "layout": {
                    "type": "flex"
                }
            },
            "core/post-featured-image": {
                "color": {
                    "defaultPalette": false
                }
            }
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                {
                    "slug": "sm",
                    "shadow": "0 2px 12px rgba(0,0,0,0.08)",
                    "name": "Small"
                },
                {
                    "slug": "md",
                    "shadow": "0 6px 24px rgba(0,0,0,0.1)",
                    "name": "Medium"
                },
                {
                    "slug": "lg",
                    "shadow": "0 12px 48px rgba(0,0,0,0.14)",
                    "name": "Large"
                },
                {
                    "slug": "gold",
                    "shadow": "0 6px 24px rgba(212,175,55,0.3)",
                    "name": "Gold Glow"
                }
            ]
        },
        "dimensions": {
            "defaultAspectRatios": true,
            "aspectRatio": true,
            "minHeight": true
        },
        "position": {
            "sticky": true
        },
        "custom": {
            "eu": {
                "header-height": "70px",
                "border-radius": "12px",
                "transition": "all 0.3s ease",
                "gold": "#D4AF37",
                "gold-dark": "#B8960C",
                "box-shadow": "0 6px 24px rgba(0,0,0,0.1)"
            }
        }
    },
    "styles": {
        "color": {
            "background": "#F8F8F8",
            "text": "#1A1A1A"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--poppins)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.7"
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--40)"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--secondary)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--primary)"
                    }
                }
            },
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "fontWeight": "800",
                    "lineHeight": "1.15",
                    "fontSize": "var(--wp--preset--font-size--hero)"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "fontWeight": "700",
                    "lineHeight": "1.2",
                    "fontSize": "var(--wp--preset--font-size--xxl)"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "fontWeight": "700",
                    "lineHeight": "1.25",
                    "fontSize": "var(--wp--preset--font-size--xl)"
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "fontWeight": "600",
                    "lineHeight": "1.3",
                    "fontSize": "var(--wp--preset--font-size--large)"
                }
            },
            "button": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "fontWeight": "600",
                    "fontSize": "var(--wp--preset--font-size--small)"
                },
                "color": {
                    "background": "var(--wp--preset--color--secondary)",
                    "text": "var(--wp--preset--color--primary)"
                },
                "border": {
                    "radius": "4px"
                },
                "spacing": {
                    "padding": {
                        "top": "0.85rem",
                        "bottom": "0.85rem",
                        "left": "2rem",
                        "right": "2rem"
                    }
                }
            }
        },
        "blocks": {
            "core/site-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "fontWeight": "700",
                    "fontSize": "var(--wp--preset--font-size--large)"
                }
            },
            "core/navigation": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "500"
                },
                "color": {
                    "text": "rgba(255,255,255,0.85)"
                }
            },
            "core/separator": {
                "color": {
                    "text": "var(--wp--preset--color--secondary)"
                },
                "border": {
                    "color": "var(--wp--preset--color--secondary)",
                    "width": "2px"
                }
            },
            "core/post-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "fontWeight": "700"
                }
            },
            "core/query-pagination": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)"
                }
            }
        }
    },
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        },
        {
            "name": "sidebar",
            "title": "Sidebar",
            "area": "uncategorized"
        }
    ],
    "customTemplates": [
        {
            "name": "front-page",
            "title": "Front Page",
            "postTypes": ["page"]
        },
        {
            "name": "page-packages",
            "title": "Packages Page",
            "postTypes": ["page"]
        },
        {
            "name": "page-contact",
            "title": "Contact Page",
            "postTypes": ["page"]
        },
        {
            "name": "page-about",
            "title": "About Page",
            "postTypes": ["page"]
        }
    ],
    "blockPatterns": []
}
