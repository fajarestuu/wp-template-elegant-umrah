<main class="wp-block-group eu-main-content">

    <!-- wp:html -->
    <div class="eu-articles-hero alignfull">
        <div class="eu-articles-hero-inner">
            <div class="eu-articles-hero-pattern" aria-hidden="true"></div>
            <div class="eu-articles-hero-content">
                <span class="eu-section-label" style="color:#D4AF37;font-size:0.75rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase">✦ Knowledge &amp; Inspiration</span>
                <h1 class="eu-articles-hero-title">News &amp; Articles</h1>
                <p class="eu-articles-hero-desc">Deepen your understanding of Hajj and Umrah. Tips, guides, and spiritual insights curated for the modern Muslim traveller.</p>
            </div>
        </div>
    </div>
    <!-- /wp:html -->

